{
  "name": "omp-freeze-audit-remediate",
  "version": "2.0.0-rc.1",
  "description": "Bounded, resumable, evidence-driven feature freeze, repository audit, bug remediation and release qualification for Oh My Pi.",
  "type": "module",
  "license": "MIT",
  "engines": {"node": ">=22"},
  "keywords": ["omp-plugin", "feature-freeze", "audit", "remediation", "parallel-agents", "durable-workflow"],
  "bin": {"omp-far": "./bin/far.mjs"},
  "scripts": {"test": "node --test tests/*.test.mjs", "check": "node scripts/check-package.mjs", "check:manifest": "node scripts/check-manifest.mjs", "release:validate": "node scripts/validate-release.mjs"},
  "files": ["package.json", "src", "bin", "skills", "agents", "docs", "configs", "examples", "scripts", "tests", "README.md", "CHANGELOG.md", "LICENSE", "MANIFEST.sha256"],
  "omp": {"extensions": ["./src/index.js"]}
}
